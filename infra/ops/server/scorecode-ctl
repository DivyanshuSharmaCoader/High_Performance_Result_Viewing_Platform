#!/usr/bin/env bash
# A fixed set of operations on the ScoreCode server (root-owned; the deploy user runs it through sudo).
#
#   sudo scorecode-ctl status                 containers and their health; the deployed version
#   sudo scorecode-ctl logs SERVICE [LINES]   recent logs of one service
#   sudo scorecode-ctl restart SERVICE        restart one service (api, worker, proxy, redis, backup, ...)
#   sudo scorecode-ctl backup                 an encrypted backup now (as the nightly job does)
#   sudo scorecode-ctl restore-test           a DECRYPTED dump on stdin, restored into a throwaway database
#                                             with no network, compared with the live one, then removed
#   sudo scorecode-ctl smoke                  the smoke test against this machine
#   sudo scorecode-ctl versions               releases kept on disk, and the deployed one
#   sudo scorecode-ctl rollback VERSION       deploy an earlier release again
#   sudo scorecode-ctl monitoring up|down     the Prometheus/Alertmanager/Grafana profile
#   sudo scorecode-ctl jobs stats|dead|retry  the job queue (scorecode jobs)
#   sudo scorecode-ctl sentry-test            send one synthetic error to Sentry (scrubbed)
#   sudo scorecode-ctl registry-login USER    log the root Docker client in to GHCR; token on stdin
#   sudo scorecode-ctl create-platform-admin  the first console account; EMAIL, NAME, PASSWORD on stdin
#   sudo scorecode-ctl install-cert           origin certificate on stdin (PEM); the key is made here
#   sudo scorecode-ctl make-csr               a new origin key (kept here) and its CSR on stdout
#   sudo scorecode-ctl render-env             settings files from the operator's values on stdin
#   sudo scorecode-ctl archive-logs           yesterday's container logs to /var/log/scorecode, gzipped,
#                                             kept 365 days (daily timer; CERT-In: 180 days in India)
#
# Each subcommand maps to a fixed command line; arguments are validated, nothing reaches a shell.
set -euo pipefail
cd /opt/scorecode
REGISTRY=$(cat /etc/scorecode/registry)
export REGISTRY
version=$(cat .deployed-version 2>/dev/null || true)
dc() {
  [ -n "$version" ] || { echo "nothing deployed yet" >&2; exit 3; }
  SCORECODE_VERSION=$version docker compose -f compose.prod.yml --env-file env/deploy.env "$@"
}
service() {
  [[ ${1:-} =~ ^(api|worker|proxy|redis|postgres|backup|prometheus|alertmanager|pushgateway|postgres-exporter|grafana)$ ]] \
    || { echo "unknown service: ${1:-}" >&2; exit 2; }
}

cmd=${1:-}; shift || true
case "$cmd" in
  status)
    echo "deployed: ${version:-nothing}"
    [ -z "$version" ] || dc ps --format 'table {{.Service}}\t{{.Status}}'
    ;;
  logs)
    service "${1:-}"; lines=${2:-100}; [[ $lines =~ ^[0-9]{1,5}$ ]] || exit 2
    dc logs --no-color --tail "$lines" "$1"
    ;;
  restart) service "${1:-}"; dc restart "$1" ;;
  backup) dc run --rm backup backup.sh ;;
  restore-test)
    # P18.10: a real restore, without the age key ever coming here (the operator decrypts on their own
    # machine: infra/ops/restore-test.py). The scratch database has no network; all of it is removed.
    [ -n "$version" ] || { echo "nothing deployed yet" >&2; exit 3; }
    work=$(mktemp -d /opt/scorecode/restore-test.XXXXXX); chmod 700 "$work"
    name=scorecode-restore-test-$$
    trap 'docker rm -f "$name" >/dev/null 2>&1 || true; rm -rf "$work"' EXIT
    head -c 8000000000 > "$work/db.dump"
    [ "$(head -c 5 "$work/db.dump")" = PGDMP ] || { echo "not a pg_dump custom-format dump" >&2; exit 2; }
    chown -R 10001 "$work"  # the backup image's user, the only one besides root that may read it
    echo "received $(du -h "$work/db.dump" | cut -f1) dump; starting a scratch database"
    docker run -d --name "$name" --network none --env-file env/db.env "$REGISTRY/scorecode-postgres:$version" >/dev/null
    for _ in $(seq 1 60); do
      docker logs "$name" 2>&1 | grep -q "PostgreSQL init process complete" \
        && docker exec "$name" pg_isready -q -U postgres 2>/dev/null && break
      sleep 2
    done
    docker exec "$name" pg_isready -q -U postgres || { echo "scratch database did not start" >&2; exit 1; }
    # The backup image's restore.sh, sharing only the scratch database's (empty) network namespace.
    docker run --rm --network "container:$name" --env-file env/db.env -v "$work:/restore:ro" \
      -e PGHOST=127.0.0.1 -e PGUSER=scorecode_migrator -e PGDATABASE=scorecode -e RESTORE_DUMP=/restore/db.dump \
      --entrypoint sh "$REGISTRY/scorecode-backup:$version" -c 'PGPASSWORD=$SCORECODE_MIGRATOR_PASSWORD exec restore.sh'
    live=$(dc ps -q postgres)
    FP_CONTAINER=$live infra/ops/db-fingerprint.sh > "$work/live.txt"
    FP_CONTAINER=$name infra/ops/db-fingerprint.sh > "$work/restored.txt"
    same=$(comm -12 <(sort "$work/live.txt") <(sort "$work/restored.txt") | wc -l)
    echo "fingerprint: $same of $(wc -l < "$work/live.txt") lines identical to the live database"
    # What differs (names, counts and checksums only): rows written since the backup was taken.
    diff <(sort "$work/live.txt") <(sort "$work/restored.txt") | grep -E '^[<>]' | sed 's/^</live:    /; s/^>/restored:/' || true
    ;;
  smoke)
    domain=$(grep -E '^BASE_DOMAIN=' env/deploy.env | head -1 | cut -d= -f2 | awk '{print $1}')
    # Straight to this machine's edge, trusting Cloudflare's Origin CA (the origin certificate's issuer).
    SMOKE_BASE_DOMAIN=$domain SMOKE_SCHEME=https SMOKE_PORT=443 SMOKE_CONNECT_TO=127.0.0.1:443 \
      SMOKE_CACERT=certs/origin-ca.pem SMOKE_TENANT="${1-}" infra/ops/smoke.sh
    ;;
  versions) echo "deployed: ${version:-nothing}"; ls -1t releases | grep -E '^v' || true ;;
  rollback)
    [[ ${1:-} =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]] || exit 2
    exec /usr/local/sbin/scorecode-deploy "$1"
    ;;
  monitoring)
    case "${1:-}" in
      up) dc --profile monitoring up -d --wait ;;
      down) dc --profile monitoring stop prometheus alertmanager pushgateway postgres-exporter grafana ;;
      *) exit 2 ;;
    esac
    ;;
  jobs)
    [[ ${1:-} =~ ^(stats|dead|retry)$ ]] || exit 2
    dc exec -T api scorecode jobs "$1"
    ;;
  sentry-test) dc exec -T api scorecode sentry-test ;;
  registry-login)
    [[ ${1:-} =~ ^[A-Za-z0-9-]{1,39}$ ]] || exit 2
    docker login ghcr.io -u "$1" --password-stdin >/dev/null && echo "logged in to ghcr.io"
    ;;
  create-platform-admin)
    # Three lines on stdin: email, name, password. Passed to the CLI through its environment only.
    # The TOTP enrolment goes back on stdout to the caller (infra/ops/create-admin.py writes it to a
    # private file); nothing is logged here.
    IFS= read -r email; IFS= read -r name; IFS= read -r SCORECODE_PLATFORM_PASSWORD_INIT
    export SCORECODE_PLATFORM_PASSWORD_INIT
    dc run --rm -T -e SCORECODE_PLATFORM_PASSWORD_INIT api \
      scorecode create-platform-user --email "$email" --name "$name" --role platform_admin
    ;;
  render-env) exec /usr/bin/python3 /usr/local/lib/scorecode/render-env.py ;;
  archive-logs)
    # The apps' logs are structured and redacted; this keeps them a year on this server (in India).
    install -d -m 750 /var/log/scorecode
    day=$(date -u -d yesterday +%F)
    out=/var/log/scorecode/$day.log.gz
    if [ -n "$version" ] && [ ! -s "$out" ]; then
      dc --profile monitoring logs --no-color --timestamps --since "${day}T00:00:00Z" \
        --until "$(date -u +%F)T00:00:00Z" | gzip -9 > "$out.tmp" && mv "$out.tmp" "$out" && chmod 640 "$out"
    fi
    find /var/log/scorecode -name '*.log.gz' -mtime +365 -delete
    ls -1 /var/log/scorecode | tail -3
    ;;
  make-csr)
    install -d -m 750 certs
    domain=$(grep -E '^BASE_DOMAIN=' env/deploy.env | head -1 | cut -d= -f2 | awk '{print $1}')
    umask 077
    openssl req -new -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
      -keyout certs/origin-key.pem.new -subj "/CN=$domain" 2>/dev/null
    ;;
  install-cert)
    cert=$(head -c 20000)
    printf '%s\n' "$cert" | openssl x509 -noout 2>/dev/null || { echo "not a certificate" >&2; exit 2; }
    [ -f certs/origin-key.pem.new ] || { echo "run make-csr first" >&2; exit 2; }
    # The certificate must belong to the new key.
    [ "$(printf '%s\n' "$cert" | openssl x509 -noout -pubkey | sha256sum)" = "$(openssl pkey -in certs/origin-key.pem.new -pubout | sha256sum)" ] \
      || { echo "certificate does not match the key" >&2; exit 2; }
    printf '%s\n' "$cert" > certs/origin.pem
    mv certs/origin-key.pem.new certs/origin-key.pem
    chmod 644 certs/origin.pem; chmod 600 certs/origin-key.pem
    openssl x509 -in certs/origin.pem -noout -subject -enddate
    [ -z "$version" ] || dc restart proxy
    ;;
  *) sed -n '2,20p' "$0" >&2; exit 2 ;;
esac
