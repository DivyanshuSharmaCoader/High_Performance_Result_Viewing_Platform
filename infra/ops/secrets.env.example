# ScoreCode master secrets file: everything needed to deploy and run production.
#
# Location:  /Users/divyanshusharma/.scorecode/scorecode.env   (directory 700, file 600; never in the repo)
# Template:  infra/ops/secrets.env.example in the repository (this file, without values)
#
# FORMAT, read literally and never executed as shell:
#   KEY=value           one per line; no "export", no spaces around "="
#   KEY=two words ok    the value is everything after the first "=", to the end of the line
#   # comment           comments go on their own line, never after a value
#   KEY=                empty means "not provided" (fine for optional ones)
#   Quotes are optional; "..." or '...' around the whole value are removed.
#   Multi-line secrets (keys, certificates): don't paste them; put the PATH to the file instead.
#
# Every example below is FAKE and only shows the shape. The check command
#   infra/ops/with-secrets.sh check
# prints only the NAMES of variables (ok / missing / still a placeholder), never a value.

# ============================================================================================
# 1. Domain and Cloudflare  (P16.1: https://thapar.<domain> with valid TLS)
# ============================================================================================
# The domain you registered (decision D23), already added to Cloudflare.
#   e.g. SCORECODE_DOMAIN=scorecode.in
SCORECODE_DOMAIN=
# Cloudflare: My Profile → API Tokens → Create Token → Custom, restricted to this one zone, with:
#   Zone · DNS · Edit; Zone · SSL and Certificates · Edit; Zone · Zone Settings · Edit; Zone · Zone · Read
#   e.g. CLOUDFLARE_API_TOKEN=FAKEcfTokenF4kef4kef4kef4kef4kef4kef4k
CLOUDFLARE_API_TOKEN=
# Cloudflare dashboard → your domain → Overview → right column, "Zone ID".
#   e.g. CLOUDFLARE_ZONE_ID=0123456789abcdef0123456789abcdef
CLOUDFLARE_ZONE_ID=

# ============================================================================================
# 2. The server  (P16.2: Ubuntu 24.04, 2–4 vCPU, 4–8 GB RAM, Indian region; Docker installed by me)
# ============================================================================================
#   e.g. DEPLOY_HOST=203.0.113.10
DEPLOY_HOST=
# A user that can sudo, for the first setup (afterwards deploys run as a "deploy" user I create).
#   e.g. DEPLOY_SSH_USER=ubuntu
DEPLOY_SSH_USER=
DEPLOY_SSH_PORT=22
# PATH to the private key that logs in to the server. Only the path: the key itself never goes in this
# file, and it is only ever handed to ssh.
#   e.g. DEPLOY_SSH_KEY_FILE=/Users/divyanshusharma/.ssh/scorecode_vm
DEPLOY_SSH_KEY_FILE=

# ============================================================================================
# 3. File storage: marksheet PDFs, logos, uploads  (Cloudflare R2 recommended: free tier, S3 API)
# ============================================================================================
# R2 → Create bucket (e.g. scorecode-files), then R2 → Manage API tokens → "Object Read & Write" on
# that bucket only.
#   e.g. FILES_S3_ENDPOINT=https://0123456789abcdef0123456789abcdef.r2.cloudflarestorage.com
FILES_S3_ENDPOINT=
#   e.g. FILES_S3_BUCKET=scorecode-files
FILES_S3_BUCKET=
#   e.g. FILES_S3_ACCESS_KEY_ID=FAKE0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5
FILES_S3_ACCESS_KEY_ID=
#   e.g. FILES_S3_SECRET_ACCESS_KEY=FAKEsecret0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4
FILES_S3_SECRET_ACCESS_KEY=
FILES_S3_REGION=auto

# ============================================================================================
# 4. Backups: a SECOND storage, ideally another provider or region than the files (P16.4)
# ============================================================================================
# e.g. AWS S3 in ap-south-1 (leave BACKUP_S3_ENDPOINT empty for AWS), or a second R2 account.
#   e.g. BACKUP_S3_ENDPOINT=          (empty for AWS)
BACKUP_S3_ENDPOINT=
#   e.g. BACKUP_S3_BUCKET=scorecode-backups-mumbai
BACKUP_S3_BUCKET=
#   e.g. BACKUP_S3_REGION=ap-south-1
BACKUP_S3_REGION=
#   e.g. BACKUP_S3_ACCESS_KEY_ID=AKIAFAKEFAKEFAKEFAKE
BACKUP_S3_ACCESS_KEY_ID=
#   e.g. BACKUP_S3_SECRET_ACCESS_KEY=FAKEfakeFAKEfakeFAKEfakeFAKEfakeFAKEfake
BACKUP_S3_SECRET_ACCESS_KEY=
# The age PUBLIC key that backups are encrypted to. Make the pair yourself, once:
#     brew install age && age-keygen -o ~/.scorecode/backup-age-key.txt
# then copy the "public key: age1..." line here. Keep backup-age-key.txt (the PRIVATE key) offline as
# well, e.g. in your password manager: without it no backup can be restored.
#   e.g. BACKUP_AGE_RECIPIENT=age1fakefakefakefakefakefakefakefakefakefakefakefakefakefake00
BACKUP_AGE_RECIPIENT=

# ============================================================================================
# 5. Email: result notices, invitations, password resets, security notices, alerts
# ============================================================================================
# Any SMTP provider: Amazon SES (ap-south-1), Resend, Postmark, Brevo. The sending domain needs the
# provider's SPF/DKIM records; with the Cloudflare token above I add them if you tell me the values.
#   e.g. SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_HOST=
SMTP_PORT=587
#   e.g. SMTP_USERNAME=AKIAFAKESMTPUSER0000
SMTP_USERNAME=
#   e.g. SMTP_PASSWORD=FAKEsmtpPassw0rdFAKEsmtpPassw0rdFAKE
SMTP_PASSWORD=
#   e.g. MAIL_FROM=ScoreCode <results@scorecode.in>
MAIL_FROM=

# ============================================================================================
# 6. Alerts (P16.5): who gets paged
# ============================================================================================
#   e.g. ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_TO=
# Optional, for phone notifications: create a bot with @BotFather, add it to a group, then read the
# group's chat id.
#   e.g. TELEGRAM_BOT_TOKEN=123456789:FAKEfakeFAKEfakeFAKEfakeFAKEfake
TELEGRAM_BOT_TOKEN=
#   e.g. TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_CHAT_ID=

# ============================================================================================
# 7. The first ScoreCode staff (platform console) account in production
# ============================================================================================
#   e.g. PLATFORM_ADMIN_EMAIL=you@example.com
PLATFORM_ADMIN_EMAIL=
#   e.g. PLATFORM_ADMIN_NAME=Divyanshu Sharma
PLATFORM_ADMIN_NAME=
# At least 12 characters, not used anywhere else. Its two-step (TOTP) enrolment is written to
# ~/.scorecode/platform-admin-totp.txt for you to scan; it is never shown in the chat.
#   e.g. PLATFORM_ADMIN_PASSWORD=FAKE-correct-horse-battery-staple
PLATFORM_ADMIN_PASSWORD=

# ============================================================================================
# 8. Container registry: the server pulls the release images from GHCR (P16.3)
# ============================================================================================
# A GitHub classic token with ONLY the read:packages scope (Settings → Developer settings →
# Personal access tokens → Tokens (classic)). Leave empty if you'd rather make the packages public.
#   e.g. GHCR_USERNAME=DivyanshuSharmaCoader
GHCR_USERNAME=
#   e.g. GHCR_READ_TOKEN=ghp_FAKEfakeFAKEfakeFAKEfakeFAKEfake0000
GHCR_READ_TOKEN=

# ============================================================================================
# 9. Optional
# ============================================================================================
# Error reports: Sentry → project → Client Keys (DSN).
#   e.g. SENTRY_DSN=https://fake0123456789abcdef@o123456.ingest.sentry.io/1234567
SENTRY_DSN=

# --------------------------------------------------------------------------------------------
# NOT needed from you: generated on the server and stored only there (mode 600), never shown:
#   database passwords (all six roles), SCORECODE_SECRET_KEY, SCORECODE_ABUSE_SIGNAL_KEY, the Grafana
#   admin password, and the CI deploy key pair (its private half goes straight to a GitHub secret).
# --------------------------------------------------------------------------------------------
