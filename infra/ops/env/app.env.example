# API and worker settings (every SCORECODE_* setting: docs/ENVIRONMENT.md).
# compose.prod.yml (P16.2). On the server: /opt/scorecode/env/app.env (directory 700, file 600).
# Never commit the filled-in file. Secrets: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

SCORECODE_BASE_DOMAIN=scorecode.example
SCORECODE_PUBLIC_SCHEME=https
SCORECODE_PUBLIC_PORT=443
SCORECODE_COOKIE_SECURE=true
SCORECODE_EXPOSE_DOCS=false                    # production refuses to start with public API docs
SCORECODE_TRUST_PROXY_HEADERS=true
SCORECODE_SECRET_KEY=CHANGE-ME
SCORECODE_ABUSE_SIGNAL_KEY=CHANGE-ME
SCORECODE_DATABASE_URL_APP=postgresql+asyncpg://scorecode_app:CHANGE-ME@postgres:5432/scorecode
SCORECODE_DATABASE_URL_PLATFORM=postgresql+asyncpg://scorecode_platform:CHANGE-ME@postgres:5432/scorecode
SCORECODE_DATABASE_URL_MIGRATOR=postgresql+asyncpg://scorecode_migrator:CHANGE-ME@postgres:5432/scorecode
SCORECODE_REDIS_URL=redis://redis:6379/0
SCORECODE_S3_ENDPOINT_URL=https://ACCOUNT.r2.cloudflarestorage.com   # or AWS S3: leave empty
SCORECODE_S3_PUBLIC_ENDPOINT_URL=https://ACCOUNT.r2.cloudflarestorage.com
SCORECODE_S3_BUCKET=scorecode-files
SCORECODE_S3_ACCESS_KEY=CHANGE-ME
SCORECODE_S3_SECRET_KEY=CHANGE-ME
SCORECODE_SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SCORECODE_SMTP_PORT=587
SCORECODE_SMTP_STARTTLS=true
SCORECODE_SMTP_USERNAME=CHANGE-ME              # leave both lines out for a relay without login
SCORECODE_SMTP_PASSWORD=CHANGE-ME
SCORECODE_MAIL_FROM=results@scorecode.example
# SCORECODE_SENTRY_DSN=https://...@sentry.io/...   # optional: errors to Sentry, PII scrubbed
SCORECODE_LOG_JSON=true
