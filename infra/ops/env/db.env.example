# Database server settings (self-hosted demo only; the passwords of the five roles).
# compose.prod.yml (P16.2). On the server: /opt/scorecode/env/db.env (directory 700, file 600).
# Never commit the filled-in file. Secrets: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE-ME
SCORECODE_MIGRATOR_PASSWORD=CHANGE-ME
SCORECODE_APP_PASSWORD=CHANGE-ME
SCORECODE_PLATFORM_PASSWORD=CHANGE-ME
SCORECODE_BACKUP_PASSWORD=CHANGE-ME
SCORECODE_MONITOR_PASSWORD=CHANGE-ME
