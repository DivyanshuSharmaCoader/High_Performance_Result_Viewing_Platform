# postgres-exporter settings (P16.5).
# compose.prod.yml (P16.2). On the server: /opt/scorecode/env/monitoring.env (directory 700, file 600).
# Never commit the filled-in file. Secrets: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

DATA_SOURCE_NAME=postgresql://scorecode_monitor:CHANGE-ME@postgres:5432/scorecode?sslmode=disable
