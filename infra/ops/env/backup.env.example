# Backup job settings (P16.4; docs/runbooks/backup-and-restore.md).
# compose.prod.yml (P16.2). On the server: /opt/scorecode/env/backup.env (directory 700, file 600).
# Never commit the filled-in file. Secrets: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

PGHOST=postgres
PGDATABASE=scorecode
PGUSER=scorecode_backup
PGPASSWORD=CHANGE-ME                            # = SCORECODE_BACKUP_PASSWORD
BACKUP_AGE_RECIPIENT=age1CHANGE-ME              # public key only: the private key stays in the vault
BACKUP_S3_URI=s3://backup-bucket-name/prod     # a different provider or region from the files bucket
BACKUP_S3_ENDPOINT=                             # empty for AWS S3 (the region picks the endpoint)
AWS_ACCESS_KEY_ID=CHANGE-ME                     # keys that can write the backup bucket
AWS_SECRET_ACCESS_KEY=CHANGE-ME
AWS_DEFAULT_REGION=ap-south-1
# The files bucket is copied too, with its own provider's keys (read-only is enough)
BACKUP_FILES_S3_URI=s3://files-bucket-name
FILES_S3_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
FILES_S3_REGION=auto
FILES_S3_ACCESS_KEY_ID=CHANGE-ME
FILES_S3_SECRET_ACCESS_KEY=CHANGE-ME
BACKUP_FILES_MIRROR=/home/backup/mirror          # a volume, so each night copies only new files
PUSHGATEWAY_URL=http://pushgateway:9091
