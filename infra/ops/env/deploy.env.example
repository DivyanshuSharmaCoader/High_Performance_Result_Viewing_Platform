# Interpolation settings (read by `docker compose --env-file env/deploy.env`, not passed to containers).
# compose.prod.yml (P16.2). On the server: /opt/scorecode/env/deploy.env (directory 700, file 600).
# Never commit the filled-in file. Secrets: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

BASE_DOMAIN=scorecode.example                  # D23: the registered domain
# Cloudflare's published ranges (https://www.cloudflare.com/ips/), so the edge sees real client addresses
TRUSTED_PROXIES=private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
API_WORKERS=2
PDF_PROCESSES=2
