# Production-style edge for the container stack: serves the three SPAs by Host and proxies the API.
# TLS is terminated in front of this (Cloudflare / a TLS Caddy in Phase 16); this listens on :8080.
{
	auto_https off
	admin off
	servers {
		# Who may tell us the client address: proxies in front of this one (a CDN's published ranges
		# in production, e.g. TRUSTED_PROXIES="173.245.48.0/20 ..."). Strict: X-Forwarded-For is read
		# from the right and the first untrusted hop is the client, so a client cannot prepend a fake.
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
		trusted_proxies_strict
	}
}

(common) {
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}
	# Defaults: `?` fills a field in only when the response didn't set it, so a page that sets its own (the
	# verify page: no referrer at all) keeps it. One directive each: `?` fields in one block form a single
	# condition (all absent), so one field set upstream would drop the others.
	header ?Referrer-Policy "strict-origin-when-cross-origin"
	header ?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	# Each page in its own browsing context group; nothing here is another site's subresource (ZAP 90004).
	header ?Cross-Origin-Opener-Policy "same-origin"
	header ?Cross-Origin-Resource-Policy "same-origin"
	@api path /api/* /v/*
	handle @api {
		reverse_proxy {
			# Every address the name resolves to (`docker compose up --scale api=N`, or N nodes in DNS),
			# re-resolved every few seconds; new requests go to the least busy one.
			dynamic a {$API_HOST:api} {$API_PORT:8000} {
				refresh 5s
			}
			lb_policy least_conn
			lb_try_duration 3s
			header_up X-Request-ID {http.request.uuid}
			# Overwritten, never passed through: the API trusts this header for rate limits and audit.
			header_up X-Real-IP {client_ip}
		}
	}
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
}

(spa) {
	# A hashed asset that no longer exists (an old tab after a deploy) is a 404, not index.html cached for
	# a year under an asset's name. Not cached either: a rollback may bring that name back.
	@gone {
		path /assets/*
		not file {
			root /srv/{args[0]}
		}
	}
	handle @gone {
		header Cache-Control "no-store"
		respond 404
	}
	handle {
		root * /srv/{args[0]}
		# style-src keeps 'unsafe-inline': toasts (sonner) and dialogs' scroll lock (react-style-singleton)
		# insert <style> elements at run time. Scripts stay 'self' only (docs/10 §8, accepted risk R-CSP).
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {$FILES_ORIGIN:http://files.localhost:8080}; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		# Cross-origin images (logos from the files host, by signed URL) load without credentials.
		header Cross-Origin-Embedder-Policy "credentialless"
		# Hashed assets are immutable (above); everything else, i.e. index.html under any app route
		# (/, /login, /me/...), is revalidated, so a deploy is picked up and never meets stale HTML.
		header ?Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

http://admin.{$BASE_DOMAIN:localhost}:8080 {
	import common
	import spa platform
}

http://verify.{$BASE_DOMAIN:localhost}:8080 {
	import common
	handle {
		reverse_proxy {
			dynamic a {$API_HOST:api} {$API_PORT:8000} {
				refresh 5s
			}
			lb_policy least_conn
			lb_try_duration 3s
			header_up X-Real-IP {client_ip}
		}
	}
}

http://files.{$BASE_DOMAIN:localhost}:8080 {
	reverse_proxy {$S3_UPSTREAM:s3:8333}
}

http://{$BASE_DOMAIN:localhost}:8080, http://www.{$BASE_DOMAIN:localhost}:8080 {
	import common
	import spa site
}

http://*.{$BASE_DOMAIN:localhost}:8080 {
	import common
	import spa tenant
}
