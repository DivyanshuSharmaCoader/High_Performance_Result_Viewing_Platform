# Copy to backend/.env for host-run development. Every setting is documented in docs/ENVIRONMENT.md.
SCORECODE_ENV=development
SCORECODE_BASE_DOMAIN=localhost
SCORECODE_PUBLIC_PORT=5173
SCORECODE_DATABASE_URL_APP=postgresql+asyncpg://scorecode_app:app-dev-pw@localhost:55432/scorecode
SCORECODE_DATABASE_URL_PLATFORM=postgresql+asyncpg://scorecode_platform:platform-dev-pw@localhost:55432/scorecode
SCORECODE_DATABASE_URL_MIGRATOR=postgresql+asyncpg://scorecode_migrator:migrator-dev-pw@localhost:55432/scorecode
SCORECODE_REDIS_URL=redis://localhost:56379/0
SCORECODE_S3_ENDPOINT_URL=http://localhost:59000
SCORECODE_S3_BUCKET=scorecode-dev
SCORECODE_SMTP_PORT=51025
SCORECODE_LOG_JSON=false
