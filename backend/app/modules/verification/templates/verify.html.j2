<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow, noarchive">
<meta name="referrer" content="no-referrer">
<title>{{ title }} · ScoreCode verification</title>
<style>
  :root {
    --bg: #f5f6f8; --card: #ffffff; --fg: #15181d; --muted: #5d6470; --line: #e3e6ea;
    --ok: #13703a; --ok-bg: #e7f6ec; --warn: #8a5300; --warn-bg: #fff4e0; --bad: #b42318; --bad-bg: #fdecea;
    --neutral: #3b4250; --neutral-bg: #eef0f3; --accent: #2952cc;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f1115; --card: #171a20; --fg: #e8eaee; --muted: #9aa1ad; --line: #2a2f38;
      --ok: #6fd697; --ok-bg: #12301f; --warn: #f5c26b; --warn-bg: #352812; --bad: #ff8a80; --bad-bg: #3a1714;
      --neutral: #c5cad3; --neutral-bg: #252a33; --accent: #8fa8ff;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans", sans-serif; }
  main { max-width: 34rem; margin: 0 auto; padding: 2.5rem 1rem 3rem; }
  .brand { display: flex; align-items: center; gap: .5rem; font-weight: 700; letter-spacing: -.01em; color: var(--muted); font-size: .9rem; margin-bottom: 1.25rem; }
  .brand b { color: var(--fg); }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 1rem; padding: 1.5rem; box-shadow: 0 1px 2px rgb(0 0 0 / .04), 0 8px 24px rgb(0 0 0 / .04); }
  .status { display: flex; gap: .875rem; align-items: flex-start; }
  .icon { flex: none; width: 2.5rem; height: 2.5rem; border-radius: 50%; display: grid; place-items: center; font-weight: 800; font-size: 1.15rem; }
  .ok .icon { background: var(--ok-bg); color: var(--ok); }
  .warn .icon { background: var(--warn-bg); color: var(--warn); }
  .bad .icon { background: var(--bad-bg); color: var(--bad); }
  .neutral .icon { background: var(--neutral-bg); color: var(--neutral); }
  h1 { margin: 0; font-size: 1.35rem; line-height: 1.25; letter-spacing: -.01em; }
  .ok h1 { color: var(--ok); } .warn h1 { color: var(--warn); } .bad h1 { color: var(--bad); }
  .lead { margin: .25rem 0 0; color: var(--muted); }
  .plain { font-weight: 400; }
  dl { margin: 1.25rem 0 0; display: grid; grid-template-columns: 1fr; gap: .75rem; }
  @media (min-width: 30rem) { dl { grid-template-columns: 1fr 1fr; } dl .wide { grid-column: 1 / -1; } }
  dt { font-size: .72rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
  dd { margin: .15rem 0 0; font-weight: 600; overflow-wrap: anywhere; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .85rem; font-weight: 500; }
  details { margin-top: 1.25rem; border-top: 1px solid var(--line); padding-top: 1rem; color: var(--muted); font-size: .9rem; }
  summary { cursor: pointer; color: var(--fg); font-weight: 600; }
  details p { margin: .5rem 0 0; }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .85em; background: var(--neutral-bg); padding: .1em .35em; border-radius: .3em; }
  form { margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: .5rem; }
  label { width: 100%; font-weight: 600; font-size: .9rem; }
  input { flex: 1 1 14rem; min-width: 0; font: inherit; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; letter-spacing: .04em; text-transform: uppercase; padding: .7rem .85rem; border-radius: .6rem; border: 1px solid var(--line); background: var(--bg); color: var(--fg); }
  input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  button { font: inherit; font-weight: 600; padding: .7rem 1.1rem; border-radius: .6rem; border: 0; background: var(--accent); color: #fff; cursor: pointer; }
  @media (prefers-color-scheme: dark) { button { color: #0f1115; } }
  .error { width: 100%; margin: 0; color: var(--bad); font-size: .9rem; }
  .fine { margin-top: 1.5rem; font-size: .8rem; color: var(--muted); }
</style>
</head>
<body>
<main>
  <div class="brand" aria-hidden="true"><b>ScoreCode</b> · result verification</div>

  {% if v %}
  <section class="card {{ tone }}" aria-labelledby="status">
    <div class="status">
      <div class="icon" aria-hidden="true">{{ icon }}</div>
      <div>
        <h1 id="status">{{ title }}</h1>
        <p class="lead">{{ message }}</p>
      </div>
    </div>
    {% if v.status != "institution_left" %}
    <dl>
      <div class="wide"><dt>Issued by</dt><dd>{{ v.institution }}</dd></div>
      <div><dt>Student</dt><dd>{{ v.student_name }}</dd></div>
      <div><dt>Enrollment no.</dt><dd class="mono">{{ v.enrollment_no }}</dd></div>
      <div class="wide"><dt>Exam</dt><dd>{{ v.exam }}<br><span class="lead plain">{{ v.term }} · {{ v.session }}</span></dd></div>
      <div><dt>Issued on</dt><dd>{{ issued_on or "—" }}</dd></div>
      <div><dt>Version</dt><dd>{{ v.version }}{% if v.version > 1 %} (revised){% endif %}</dd></div>
      <div class="wide"><dt>Verification code</dt><dd class="mono">{{ v.code }}</dd></div>
      {% if v.document_sha256 %}
      <div class="wide"><dt>Document fingerprint (SHA-256)</dt><dd class="mono">{{ v.document_sha256 }}</dd></div>
      {% endif %}
    </dl>
    <details>
      <summary>How to check the PDF you received</summary>
      <p>The details above come from the institution's records, not from the document. A genuine PDF has the fingerprint shown above. To compute it, run <code>shasum -a 256 file.pdf</code> on macOS or Linux, or <code>certutil -hashfile file.pdf SHA256</code> on Windows. An edited file gets a different fingerprint.</p>
      <p>For privacy, names and numbers are partly hidden and marks are not shown. Ask the student or the institution for the full statement.</p>
    </details>
    {% endif %}
  </section>
  {% else %}
  <section class="card {{ tone }}" aria-labelledby="status">
    <div class="status">
      <div class="icon" aria-hidden="true">{{ icon }}</div>
      <div>
        <h1 id="status">{{ title }}</h1>
        <p class="lead">{{ message }}</p>
      </div>
    </div>
  </section>
  {% endif %}

  <form method="get" action="/v" role="search">
    <label for="code">{% if v %}Check another code{% else %}Verification code{% endif %}</label>
    <input id="code" name="code" autocomplete="off" autocapitalize="characters" spellcheck="false" inputmode="text"
           placeholder="7KQ3-M9XD-PA2F-…" value="{{ typed or '' }}" maxlength="40"{% if error %} aria-invalid="true" aria-describedby="code-error"{% endif %} required>
    <button type="submit">Verify</button>
    {% if error %}<p class="error" id="code-error">{{ error }}</p>{% endif %}
  </form>

  <p class="fine">The code is printed beside the QR code on the statement of marks. Lookups are rate-limited and not recorded with your identity.</p>
</main>
</body>
</html>
