<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Statement of marks · {{ student.name }} · {{ exam.name }}</title>
<meta name="author" content="{{ institution.display_name }}">
<meta name="generator" content="ScoreCode">
<style>
  @page {
    size: A4;
    margin: 15mm 15mm 17mm;
    @bottom-left { content: "{{ verify.code }}"; font: 7pt "DejaVu Sans Mono", monospace; color: #8a8f98; }
    @bottom-right { content: "Page " counter(page) " of " counter(pages); font: 7.5pt "Noto Sans", "DejaVu Sans", sans-serif; color: #8a8f98; }
  }
  * { box-sizing: border-box; }
  html { font-family: "Noto Sans", "DejaVu Sans", sans-serif; font-size: 9.5pt; color: #1b1f24; line-height: 1.4; }
  body { margin: 0; }
  .rule { height: 3pt; background: {{ institution.color }}; margin-bottom: 7mm; }
  header { display: flex; align-items: center; gap: 5mm; }
  header img { max-height: 17mm; max-width: 34mm; }
  header > div { flex: 1; min-width: 0; }
  .inst { font-size: 15pt; font-weight: 700; letter-spacing: -0.01em; }
  .muted { color: #5d6470; }
  .small { font-size: 8pt; }
  .title { margin: 7mm 0 4mm; padding-bottom: 3mm; border-bottom: 0.6pt solid #d7dbe0; }
  .kicker { font-size: 7.5pt; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: {{ institution.color }}; }
  .exam { font-size: 13pt; font-weight: 700; margin-top: 1mm; }
  dl.who { display: flex; flex-wrap: wrap; margin: 0 0 5mm; }
  dl.who div { width: 50%; padding: 1.2mm 0; }
  dt { font-size: 7.5pt; text-transform: uppercase; letter-spacing: 0.08em; color: #5d6470; }
  dd { margin: 0.4mm 0 0; font-weight: 600; }
  table { width: 100%; border-collapse: collapse; }
  th { font-size: 7.5pt; text-transform: uppercase; letter-spacing: 0.06em; color: #5d6470; text-align: left; font-weight: 600; padding: 2mm 2mm; border-bottom: 0.8pt solid #1b1f24; }
  td { padding: 2.2mm 2mm; border-bottom: 0.5pt solid #e3e6ea; vertical-align: top; }
  tr { break-inside: avoid; }
  .num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .code { font-family: "DejaVu Sans Mono", monospace; font-size: 8pt; color: #5d6470; white-space: nowrap; }
  .parts { display: block; font-size: 7.5pt; color: #5d6470; margin-top: 0.6mm; }
  .fail { color: #b42318; font-weight: 600; }
  .summary { display: flex; align-items: center; gap: 6mm; margin-top: 6mm; padding: 4mm 5mm; border: 0.6pt solid #d7dbe0; border-radius: 2mm; break-inside: avoid; }
  .badge { display: inline-block; padding: 1.2mm 3.5mm; border-radius: 10mm; font-weight: 700; font-size: 10pt; }
  .badge.pass { background: #e7f6ec; color: #13703a; }
  .badge.fail { background: #fdecea; color: #b42318; }
  .badge.warn { background: #fff4e0; color: #8a5300; }
  .badge.neutral { background: #eef0f3; color: #3b4250; }
  .figures { display: flex; gap: 5mm; flex: 1; margin: 0; }
  .figures div { flex: 1 1 0; min-width: 0; }
  .figures dd { font-size: 12pt; }
  .notes { margin: 3mm 0 0; padding-left: 4mm; font-size: 8.5pt; color: #3b4250; }
  .revised { margin-top: 4mm; padding: 2.5mm 4mm; background: #fff4e0; color: #6b4100; border-radius: 1.5mm; font-size: 8.5pt; }
  .verify { display: flex; gap: 5mm; align-items: center; margin-top: 8mm; padding-top: 4mm; border-top: 0.6pt solid #d7dbe0; break-inside: avoid; }
  .verify img { width: 25mm; height: 25mm; }
  .verify .code-text { font-family: "DejaVu Sans Mono", monospace; font-size: 9pt; font-weight: 700; letter-spacing: 0.04em; }
  footer { margin-top: 5mm; font-size: 7.5pt; color: #8a8f98; }
</style>
</head>
<body>
  <div class="rule"></div>
  <header>
    {% if institution.logo %}<img src="{{ institution.logo }}" alt="">{% endif %}
    <div>
      <div class="inst">{{ institution.display_name }}</div>
      {% if institution.official_name %}<div class="muted">{{ institution.official_name }}</div>{% endif %}
      {% if institution.affiliation or institution.address %}
      <div class="muted small">{{ institution.affiliation or "" }}{% if institution.affiliation and institution.address %} · {% endif %}{{ institution.address or "" }}</div>
      {% endif %}
    </div>
  </header>

  <section class="title">
    <div class="kicker">Statement of marks</div>
    <div class="exam">{{ exam.name }}</div>
    <div class="muted">{{ exam.term }} · {{ exam.session }}</div>
  </section>

  <dl class="who">
    <div><dt>Name</dt><dd>{{ student.name }}</dd></div>
    <div><dt>Enrollment no.</dt><dd>{{ student.enrollment_no }}</dd></div>
    {% if student.cohort %}<div><dt>Class / section</dt><dd>{{ student.cohort }}</dd></div>{% endif %}
    {% if student.program %}<div><dt>Programme</dt><dd>{{ student.program }}</dd></div>{% endif %}
  </dl>

  <table>
    <thead>
      <tr>
        <th>Code</th>
        <th>Paper</th>
        {% if has_credits %}<th class="num">Credits</th>{% endif %}
        <th class="num">Marks</th>
        <th class="num">Grade</th>
        <th>Result</th>
      </tr>
    </thead>
    <tbody>
      {% for p in papers %}
      <tr>
        <td class="code">{{ p.code }}</td>
        <td>{{ p.name }}{% if p.components %}<span class="parts">{{ p.components }}</span>{% endif %}</td>
        {% if has_credits %}<td class="num">{{ p.credits if p.credits is not none else "—" }}</td>{% endif %}
        <td class="num">{{ p.total }} / {{ p.max }}</td>
        <td class="num">{{ p.grade }}</td>
        <td{% if p.failed %} class="fail"{% endif %}>{{ p.outcome }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <section class="summary">
    <div><span class="badge {{ result.tone }}">{{ result.outcome }}</span></div>
    <dl class="figures">
      <div><dt>Total</dt><dd>{{ result.total }} / {{ result.max }}</dd></div>
      {% if result.percentage %}<div><dt>Percentage</dt><dd>{{ result.percentage }}</dd></div>{% endif %}
      {% if result.grade %}<div><dt>Grade</dt><dd>{{ result.grade }}</dd></div>{% endif %}
      {% if result.sgpa %}<div><dt>SGPA</dt><dd>{{ result.sgpa }}</dd></div>
      {% elif result.grade_point %}<div><dt>Grade point</dt><dd>{{ result.grade_point }}</dd></div>{% endif %}
      {% if result.credits %}<div><dt>Credits</dt><dd>{{ result.credits }}</dd></div>{% endif %}
      {% if result.rank %}<div><dt>Rank</dt><dd>{{ result.rank }}</dd></div>{% endif %}
    </dl>
  </section>
  {% if result.notes %}
  <ul class="notes">{% for n in result.notes %}<li>{{ n }}</li>{% endfor %}</ul>
  {% endif %}
  {% if revised %}
  <div class="revised">Revised statement (version {{ version }}). It replaces any earlier statement of marks for this exam.</div>
  {% endif %}

  <section class="verify">
    <img src="{{ verify.qr }}" alt="Verification QR code">
    <div>
      <div style="font-weight:700">Verify this statement</div>
      <div class="muted">Scan the code, or visit <strong>{{ verify.display }}</strong></div>
      <div style="margin-top:1.5mm"><span class="muted small">Verification code</span><br><span class="code-text">{{ verify.code }}</span></div>
      <div class="muted small" style="margin-top:1.5mm">Issued {{ issued_on }} · Grading: {{ scheme }}</div>
    </div>
  </section>

  <footer>
    {% if footer_text %}{{ footer_text }}<br>{% endif %}
    Issued by {{ institution.display_name }}{% if powered_by %} through ScoreCode{% endif %}. Anyone can check this statement at the address above; the page shows whether it is current.
  </footer>
</body>
</html>
